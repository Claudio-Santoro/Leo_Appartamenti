---
// Privacy e Condizioni: bozze con segnaposto [[…]], da far verificare al titolare prima della pubblicazione.
import Base from '../layouts/Base.astro';
import sito from '../data/sito.json';
interface Props { lang: 'it' | 'en'; kind: 'privacy' | 'terms' }
const { lang, kind } = Astro.props;
const c = sito.condizioni;
const ph = (s: string) => `<span class="ph">${s}</span>`;
const titolare = 'Carmelo Ferro';
const pages = {
  privacy: {
    it: {
      title: 'Privacy e cookie', sections: [
        ['Titolare del trattamento', `${titolare}, ${sito.indirizzo}. Contatti: ${sito.email}.`],
        ['Quali dati raccogliamo', 'Solo i dati che ci invii con il modulo di richiesta o via WhatsApp/email: nome, email, telefono, date e numero di ospiti, messaggio.'],
        ['Perché li usiamo', 'Per rispondere alla tua richiesta e, se prenoti, per gestire il soggiorno e gli obblighi di legge (registrazione degli ospiti alla Questura tramite Alloggiati Web, tassa di soggiorno). Base giuridica: misure precontrattuali e obblighi di legge (art. 6.1 b e c GDPR).'],
        ['Dove sono conservati', 'Le richieste inviate dal modulo passano da Cloudflare (fornitore dell’hosting) e da Resend (servizio di invio email, che ne tiene copia per 30 giorni) e arrivano alla nostra email. Le conserviamo per il tempo necessario a rispondere e, in caso di prenotazione, per i tempi previsti dalla legge.'],
        ['Cookie', 'Questo sito non usa cookie di profilazione né strumenti di tracciamento pubblicitario. La mappa è fornita da OpenStreetMap. Per questo non serve un banner per i cookie.'],
        ['I tuoi diritti', `Puoi chiedere in qualsiasi momento accesso, rettifica o cancellazione dei tuoi dati scrivendo a ${sito.email}, e puoi presentare reclamo al Garante per la protezione dei dati personali.`],
      ],
    },
    en: {
      title: 'Privacy & cookies', sections: [
        ['Data controller', `${titolare}, ${sito.indirizzo}. Contact: ${sito.email}.`],
        ['What data we collect', 'Only the data you send us through the request form or by WhatsApp/email: name, email, phone, dates and number of guests, message.'],
        ['Why we use it', 'To reply to your request and, if you book, to manage your stay and meet legal obligations (guest registration with the police via Alloggiati Web, tourist tax). Legal basis: pre-contractual measures and legal obligations (Art. 6.1 b and c GDPR).'],
        ['Where it is stored', 'Requests sent through the form go through Cloudflare (our hosting provider) and Resend (email delivery service, which keeps a copy for 30 days) and reach our email. We keep them as long as needed to reply and, if you book, for the periods required by law.'],
        ['Cookies', 'This website uses no profiling cookies or advertising trackers. The map is provided by OpenStreetMap. No cookie banner is therefore required.'],
        ['Your rights', `You can ask at any time to access, correct or delete your data by writing to ${sito.email}, and you may lodge a complaint with the Italian Data Protection Authority (Garante).`],
      ],
    },
  },
  terms: {
    it: {
      title: 'Condizioni di soggiorno', sections: [
        ['Prenotazione', `La richiesta inviata dal sito non è vincolante. La prenotazione è confermata quando ricevi la nostra conferma e versi la caparra (${c.caparra.it}).`],
        ['Soggiorno minimo', c.soggiornoMinimo.it],
        ['Cancellazione', `Cancellazione ${c.cancellazione.it}. Se cancelli a meno di 30 giorni dall’arrivo la caparra non viene restituita, salvo motivi validi e documentati.`],
        ['Check-in e check-out', `Check-in di persona dalle ${sito.checkin.replace('–', ' alle ')}, flessibile su richiesta. Check-out dalle ${sito.checkout.replace('–', ' alle ')}. All’arrivo serve un documento d’identità valido per ogni ospite (obbligo di legge).`],
        ['Tassa di soggiorno', `${ph(c.tassaSoggiorno)}, non inclusa nel prezzo.`],
        ['Animali', `Ammessi su richiesta, ${ph(c.animali)}.`],
        ['Regole della casa', 'Non sono ammesse feste né addii al celibato o al nubilato. Gli appartamenti sono per non fumatori. Rispettate il riposo dei vicini.'],
        ['Pagamento', `Caparra con bonifico bancario; saldo all’arrivo. Accettiamo contanti in loco.`],
      ],
    },
    en: {
      title: 'Terms of stay', sections: [
        ['Booking', `A request sent through the website is not binding. Your booking is confirmed once you receive our confirmation and pay the deposit (${c.caparra.en}).`],
        ['Minimum stay', c.soggiornoMinimo.en],
        ['Cancellation', `Cancellation ${c.cancellazione.en}. If you cancel less than 30 days before arrival the deposit is not refunded, unless for valid, documented reasons.`],
        ['Check-in and check-out', `In-person check-in from ${sito.checkin.replace('–', ' to ')}, flexible on request. Check-out from ${sito.checkout.replace('–', ' to ')}. A valid ID is required for every guest on arrival (legal requirement).`],
        ['Tourist tax', `${ph(c.tassaSoggiorno)}, not included in the price.`],
        ['Pets', `Allowed on request, ${ph(c.animali)}.`],
        ['House rules', 'No parties, stag or hen dos. All apartments are non-smoking. Please respect the neighbours’ rest.'],
        ['Payment', `Deposit by bank transfer; balance on arrival. Cash accepted on site.`],
      ],
    },
  },
};
const P = pages[kind][lang];
---
<Base lang={lang} page={kind} title={`${P.title} · Leo Appartamenti Erice`} description={P.title}>
  <section class="page-head"><div class="wrap enter"><h1>{P.title}</h1></div></section>
  <section class="section tight">
    <div class="wrap prose">
      {P.sections.map(([h, p]) => <><h2>{h}</h2><p set:html={p} /></>)}
      <p class="small muted" style="margin-top:48px">CIR {sito.cir} · CIN {sito.cin.join(' · ')}</p>
    </div>
  </section>
</Base>
