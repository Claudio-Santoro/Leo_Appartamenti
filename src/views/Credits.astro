---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import crediti from '../data/crediti.json';
import { img } from '../images.js';
interface Props { lang: 'it' | 'en' }
const { lang } = Astro.props;
const T = {
  it: { title: 'Crediti fotografici', lead: 'Le foto di Erice e dei dintorni elencate qui sotto vengono da Wikimedia Commons e da Pexels e sono usate secondo le loro licenze libere (ridimensionate per il web). Le foto degli appartamenti, quella della strada affacciata sulle Egadi e quella del vicolo di Erice di notte, nell’apertura su telefono, sono dei proprietari. Il Castello di Venere di notte, su telefono, è una rielaborazione digitale della foto di Dmitry Romanoff.', by: 'Foto di', source: 'fonte' },
  en: { title: 'Photo credits', lead: 'The photos of Erice and its surroundings listed below come from Wikimedia Commons and Pexels and are used under their free licences (resized for the web). The photos of the apartments, that of the road overlooking the Egadi Islands and the night view of an alley in Erice shown at the top of the page on phones, belong to the owners. The night view of the Castle of Venus on phones is a digital reworking of the photo by Dmitry Romanoff.', by: 'Photo by', source: 'source' },
}[lang];
---
<Base lang={lang} page="credits" title={`${T.title} · LEO Appartamenti`} description={T.lead}>
  <section class="page-head"><div class="wrap enter"><h1>{T.title}</h1><p class="lead">{T.lead}</p></div></section>
  <section class="section tight"><div class="wrap">
    <ul class="credits">
      {crediti.map((c) => (
        <li>
          <Image src={img(c.file.replace(/\.jpg$/, ''))} alt="" widths={[360]} sizes="240px" />
          {T.by} {c.author} · <a href={c.licenseUrl} rel="license noopener" target="_blank">{c.license}</a> · <a href={c.source} rel="noopener" target="_blank">{T.source}</a>
        </li>
      ))}
    </ul>
  </div></section>
</Base>
