---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import crediti from '../data/crediti.json';
import { img } from '../images.js';
interface Props { lang: 'it' | 'en' }
const { lang } = Astro.props;
const T = {
  it: { title: 'Crediti fotografici', lead: 'Le foto di Erice e dei dintorni elencate qui sotto vengono da Wikimedia Commons e da Pexels e sono usate secondo le loro licenze libere (ridimensionate per il web). Le foto degli appartamenti, quella della strada al tramonto, su telefono, e quella del vicolo di Erice di notte, nell’apertura su telefono, sono dei proprietari. Le due viste notturne del Castello di Venere, su telefono, sono rielaborazioni digitali delle foto di Dmitry Romanoff e lemapuche breton.', by: 'Foto di', source: 'fonte' },
  en: { title: 'Photo credits', lead: 'The photos of Erice and its surroundings listed below come from Wikimedia Commons and Pexels and are used under their free licences (resized for the web). The photos of the apartments, that of the road at sunset shown on phones and the night view of an alley in Erice shown at the top of the page on phones, belong to the owners. The two night views of the Castle of Venus on phones are digital reworkings of the photos by Dmitry Romanoff and lemapuche breton.', by: 'Photo by', source: 'source' },
}[lang];
---
<Base lang={lang} page="credits" title={`${T.title} · Leo Appartamenti`} description={T.lead}>
  <section class="page-head"><div class="wrap enter"><h1>{T.title}</h1><p class="lead">{T.lead}</p></div></section>
  <section class="section tight"><div class="wrap">
    <ul class="credits">
      {crediti.map((c) => (
        <li>
          <Image src={img(c.file.replace(/\.jpg$/, ''))} alt="" widths={[360]} sizes="240px" />
          {T.by} {c.author} · <a href={c.licenseUrl} rel="license noopener" target="_blank">{c.license}</a> · <a href={c.source} rel="noopener" target="_blank">{T.source}</a>
        </li>
      ))}
    </ul>
  </div></section>
</Base>
