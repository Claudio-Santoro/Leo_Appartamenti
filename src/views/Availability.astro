---
import Base from '../layouts/Base.astro';
import Calendar from '../components/Calendar.astro';
import RequestForm from '../components/RequestForm.astro';
import sito from '../data/sito.json';
interface Props { lang: 'it' | 'en' }
const { lang } = Astro.props;
const T = {
  it: { title: 'Disponibilità e prenotazione diretta · Appartamenti a Erice', desc: 'Controlla le date libere dei nostri appartamenti a Erice (Venere, Elimo e Balio) e chiedi la tua prenotazione diretta, senza costi di intermediazione.', h1: 'Disponibilità', lead: 'Scegli uno o più appartamenti e tocca le date: il modulo qui sotto si compila da solo. Ti rispondiamo con conferma e prezzo.', formN: 'Ultimo passo', form: 'La tua richiesta', or: 'Preferisci parlarci?', call: 'Chiamaci al' },
  en: { title: 'Availability and direct booking · Apartments in Erice', desc: 'Check available dates for our apartments in Erice (Venere, Elimo and Balio) and send a direct booking request, with no booking fees.', h1: 'Availability', lead: 'Pick one or more apartments and tap your dates: the form below fills in automatically. We will reply with confirmation and price.', formN: 'Last step', form: 'Your request', or: 'Prefer to talk?', call: 'Call us on' },
}[lang];
---
<Base lang={lang} page="avail" title={T.title} description={T.desc} bar={false}>
  <section class="page-head compact"><div class="wrap enter">
    <h1>{T.h1}</h1>
    <p class="lead">{T.lead}</p>
  </div></section>
  <section class="section tight">
    <div class="wrap" style="display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(56px,8vw,96px)">
      <Calendar lang={lang} />
      <div id="richiesta">
        <span class="num">{T.formN}</span>
        <h2>{T.form}</h2>
        <RequestForm lang={lang} />
        <p class="muted" style="margin-top:20px">{T.or}<br />{T.call} <a href={`tel:${sito.telefono.replace(/\s/g, '')}`}>{sito.telefono}</a></p>
      </div>
    </div>
  </section>
</Base>
