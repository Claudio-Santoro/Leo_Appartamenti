---
import Base from '../layouts/Base.astro';
import Calendar from '../components/Calendar.astro';
import RequestForm from '../components/RequestForm.astro';
import sito from '../data/sito.json';
interface Props { lang: 'it' | 'en' }
const { lang } = Astro.props;
const T = {
  it: { title: 'Disponibilità e richiesta di prenotazione · Leo Appartamenti Erice', desc: 'Controlla le date libere di Venere, Elimo e Balio e chiedi la tua prenotazione diretta.', eyebrow: 'Prenota diretto', h1: 'Disponibilità', lead: 'Scegli l’appartamento e tocca le date sul calendario: il modulo qui sotto si compila da solo. Ti rispondiamo con conferma e prezzo.', formN: 'Ultimo passo', form: 'La tua richiesta', or: 'Preferisci parlarci?', call: 'Chiamaci al' },
  en: { title: 'Availability and booking request · Leo Appartamenti Erice', desc: 'Check available dates for Venere, Elimo and Balio and send a direct booking request.', eyebrow: 'Book direct', h1: 'Availability', lead: 'Pick the apartment and tap your dates on the calendar: the form below fills in automatically. We will reply with confirmation and price.', formN: 'Last step', form: 'Your request', or: 'Prefer to talk?', call: 'Call us on' },
}[lang];
---
<Base lang={lang} page="avail" title={T.title} description={T.desc} bar={false}>
  <section class="page-head"><div class="wrap enter">
    <p class="eyebrow">{T.eyebrow}</p>
    <h1>{T.h1}</h1>
    <p class="lead">{T.lead}</p>
  </div></section>
  <section class="section tight">
    <div class="wrap" style="display:grid;gap:clamp(56px,8vw,96px)">
      <Calendar lang={lang} />
      <div id="richiesta">
        <span class="num">{T.formN}</span>
        <h2>{T.form}</h2>
        <RequestForm lang={lang} />
        <p class="muted" style="margin-top:20px">{T.or} {T.call} <a href={`tel:${sito.telefono.replace(/\s/g, '')}`}>{sito.telefono}</a> · <a href={`mailto:${sito.email}`}>{sito.email}</a></p>
      </div>
    </div>
  </section>
</Base>
