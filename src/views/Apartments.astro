---
import Base from '../layouts/Base.astro';
import ApartmentCard from '../components/ApartmentCard.astro';
import apts from '../data/appartamenti.json';
import { url, ui } from '../i18n.js';
interface Props { lang: 'it' | 'en' }
const { lang } = Astro.props;
const t = ui[lang];
const yes = lang === 'it' ? 'Sì' : 'Yes';
const T = {
  it: { title: 'Appartamenti a Erice per 4–7 persone · Leo Appartamenti', desc: 'Venere, Elimo e Balio: tre appartamenti per le vacanze a Erice, da 4 a 7 persone, con cucina, Wi-Fi e parcheggio. Confrontali e scegli quello giusto per te.', eyebrow: 'Tre case, una vista', h1: 'Gli appartamenti a Erice', lead: 'Venere è il più grande, con camino e cortile; Elimo e Balio sono pensati per coppie e piccole famiglie. Per i gruppi si prenotano insieme.', compareN: 'Il confronto', compare: 'Quale fa per te?', size: 'Superficie', guests: 'Ospiti', layout: 'Caratteristiche', all: 'In tutti', allList: 'Cucina, aria condizionata e riscaldamento, Wi-Fi gratuito, TV, lavatrice, patio, bagno con doccia. Animali su richiesta.' },
  en: { title: 'Holiday apartments in Erice for 4–7 guests · Leo Appartamenti', desc: 'Venere, Elimo and Balio: three holiday apartments in Erice, Sicily, for 4 to 7 guests, with kitchen, Wi-Fi and parking. Compare them and choose the right one for you.', eyebrow: 'Three homes, one view', h1: 'Our apartments in Erice', lead: 'Venere is the largest, with fireplace and courtyard; Elimo and Balio suit couples and small families. Groups can book them together.', compareN: 'Side by side', compare: 'Which one suits you?', size: 'Size', guests: 'Guests', layout: 'Features', all: 'In all of them', allList: 'Kitchen, air conditioning and heating, free Wi-Fi, TV, washing machine, patio, bathroom with shower. Pets on request.' },
}[lang];
const rows: [string, (a: any) => string][] = [
  [T.size, (a) => `${a.mq} m²`],
  [T.guests, (a) => String(a.ospiti)],
  [t.beds, (a) => a.letti[lang]],
  [t.baths, (a) => String(a.bagni)],
  [T.layout, (a) => a.piano[lang]],
  [t.fireplace, (a) => (a.camino ? yes : '—')],
];
---
<Base lang={lang} page="apts" title={T.title} description={T.desc}>
  <section class="page-head"><div class="wrap enter">
    <p class="eyebrow">{T.eyebrow}</p>
    <h1>{T.h1}</h1>
    <p class="lead">{T.lead}</p>
  </div></section>

  <section class="section tight">
    <div class="apts">
      {apts.map((a) => <ApartmentCard a={a} lang={lang} full />)}
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="head"><div><span class="num">{T.compareN}</span><h2>{T.compare}</h2></div></div>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr><td></td>{apts.map((a) => <th scope="col"><a href={url('apts', lang, a.id)}>{a.nome}</a></th>)}</tr></thead>
          <tbody>
            {rows.map(([label, val]) => <tr><th scope="row">{label}</th>{apts.map((a) => <td data-apt={a.nome}>{val(a)}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
      <p style="margin:28px 0"><strong>{T.all}:</strong> {T.allList}</p>
      <a class="btn" href={url('avail', lang)}>{t.checkAvail}</a>
    </div>
  </section>
</Base>
