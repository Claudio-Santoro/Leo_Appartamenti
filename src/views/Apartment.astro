---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import apts from '../data/appartamenti.json';
import servizi from '../data/servizi.json';
import sito from '../data/sito.json';
import { url, ui } from '../i18n.js';
import { photos } from '../images.js';
import { getImage } from 'astro:assets';
interface Props { lang: 'it' | 'en'; id: string }
const { lang, id } = Astro.props;
const a = apts.find((x) => x.id === id)!;
const t = ui[lang];
const T = {
  it: { amen: 'Dotazioni', info: 'In breve', checkin: 'Check-in', checkout: 'Check-out', flex: 'flessibile su richiesta', price: 'Prezzo', priceVal: 'su richiesta', others: 'Gli altri appartamenti', name: 'Il nome', swipe: 'Scorri per vedere tutte le foto →', size: 'Superficie', guests: 'Ospiti', beds: 'Letti' },
  en: { amen: 'Amenities', info: 'At a glance', checkin: 'Check-in', checkout: 'Check-out', flex: 'flexible on request', price: 'Price', priceVal: 'on request', others: 'The other apartments', name: 'The name', swipe: 'Swipe to see all the photos →', size: 'Size', guests: 'Guests', beds: 'Beds' },
}[lang];
const others = apts.filter((x) => x.id !== id);
// ponytail: prezzi ancora null in appartamenti.json → "su richiesta". Quando ci saranno, mostra "da € X / notte".
const prices = Object.values(a.prezzi).filter((v): v is number => typeof v === 'number');
const gallery = photos(a.id, lang, a.nome);
const abs = (u: string) => new URL(u, Astro.site).href;
const cover = await getImage({ src: gallery[0].src, width: 1200, format: 'jpg', quality: 80 });
const desc = `${a.breve[lang]} ${lang === 'it' ? 'Appena fuori dalle mura di Erice, con parcheggio e Wi-Fi gratuito.' : 'Just outside the walls of Erice, with parking and free Wi-Fi.'}`;
const ld = [
  { '@context': 'https://schema.org', '@type': 'Apartment', name: `${a.nome} · Leo Appartamenti`, description: a.descrizione[lang], url: abs(url('apts', lang, a.id)), image: abs(cover.src),
    floorSize: { '@type': 'QuantitativeValue', value: a.mq, unitCode: 'MTK' }, occupancy: { '@type': 'QuantitativeValue', maxValue: a.ospiti }, numberOfBathroomsTotal: a.bagni,
    amenityFeature: servizi.map((x) => ({ '@type': 'LocationFeatureSpecification', name: x[lang], value: true })),
    containedInPlace: { '@id': `${abs('/')}#struttura` } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Leo Appartamenti', item: abs(url('home', lang)) },
    { '@type': 'ListItem', position: 2, name: t.nav.apts, item: abs(url('apts', lang)) },
    { '@type': 'ListItem', position: 3, name: a.nome, item: abs(url('apts', lang, a.id)) },
  ] },
];
const priceText = prices.length ? `${lang === 'it' ? 'da' : 'from'} € ${Math.min(...prices)} / ${lang === 'it' ? 'notte' : 'night'}` : T.priceVal;
---
<Base lang={lang} page="apts" id={id} title={`${a.nome} · ${a.mq} m², ${a.ospiti} ${t.guests} · Leo Appartamenti Erice`} description={desc} image={gallery[0].src}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <section class="page-head" style="padding-bottom:28px"><div class="wrap enter">
    <p class="crumbs"><a href={url('apts', lang)}>{t.nav.apts}</a> / {a.nome}</p>
    <h1>{a.nome}</h1>
    <p class="lead">{a.breve[lang]}</p>
  </div></section>

  <section>
    <Gallery photos={gallery} lang={lang} />
    <p class="gallery-hint wrap">{T.swipe}</p>
  </section>

  <section class="section">
    <div class="wrap split top">
      <div>
        <p style="font-size:1.25rem;line-height:1.6">{a.descrizione[lang]}</p>
        <p class="muted"><em>{T.name}: {a.nomeOrigine[lang]}</em></p>
        <h2 style="font-size:2.6rem;margin-top:1.4em">{T.amen}</h2>
        <ul class="ticks">{servizi.map((x) => <li>{x[lang]}</li>)}{a.camino && <li>{t.fireplace}</li>}</ul>
      </div>
      <aside class="info-card">
        <h2>{T.info}</h2>
        <dl>
          <dt>{T.size} · {T.guests}</dt><dd>{a.mq} m² · {a.ospiti} {t.guests}</dd>
          <dt>{T.beds}</dt><dd>{a.letti[lang]}</dd>
          <dt>{T.price}</dt><dd>{priceText}</dd>
          <dt>{T.checkin}</dt><dd>{sito.checkin} ({T.flex})</dd>
          <dt>{T.checkout}</dt><dd>{sito.checkout}</dd>
          {a.cin && <><dt>CIN</dt><dd>{a.cin}</dd></>}
        </dl>
        <a class="btn" href={`${url('avail', lang)}?apt=${a.id}`}>{t.checkAvail}</a>
      </aside>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2 style="margin-bottom:40px">{T.others}</h2>
      <div class="others">
        {others.map((o) => {
          const c = photos(o.id, lang, o.nome)[0];
          return (
            <a href={url('apts', lang, o.id)} data-reveal>
              <Image class="thumb" src={c.src} alt={c.alt} widths={[240]} sizes="120px" />
              <div><h3>{o.nome}</h3><p>{o.breve[lang]}</p></div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Base>
