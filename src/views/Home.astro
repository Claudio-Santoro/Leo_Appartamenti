---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import apts from '../data/appartamenti.json';
import sito from '../data/sito.json';
import { url, ui } from '../i18n.js';
import { photos } from '../images.js';
interface Props { lang: 'it' | 'en' }
const { lang } = Astro.props;
const t = ui[lang];
const hero = photos('venere', lang)[0];
const erice = photos('erice', lang);
const T = {
  it: {
    title: 'LEO Appartamenti · Appartamenti con vista a Erice',
    desc: 'Tre appartamenti a Erice, appena fuori dalle mura, con vista sul mare di Trapani. Si arriva in auto fino alla porta. Accoglienza di persona e check-in flessibile.',
    h1: 'Erice, con vista sul mare',
    sub: 'Tre appartamenti a due passi da Porta Trapani, con patio panoramico, parcheggio e accoglienza di persona.',
    discover: 'Scopri gli appartamenti',
    why: [
      ['Vista panoramica', 'Dal patio si vedono Trapani e il mare. È la cosa che i nostri ospiti ricordano di più.'],
      ['Accoglienza di persona', 'Ti accogliamo noi all’arrivo, con consigli su dove mangiare e cosa vedere. Check-in flessibile su richiesta.'],
      ['In auto fino alla porta', 'Siamo fuori dalla zona a traffico limitato, con parcheggio e colonnina per l’auto elettrica. Porta Trapani e la funivia sono a pochi passi.'],
    ],
    aptsH: 'Gli appartamenti',
    aptsP: 'Tutti con cucina, aria condizionata e riscaldamento, Wi-Fi gratuito, lavatrice e patio.',
    groupH: 'Siete in tanti?',
    groupP: 'Prenotate tutta la struttura: tre appartamenti vicini, fino a 15 persone. Perfetto per famiglie allargate e gruppi di amici.',
    groupBtn: 'Chiedi per il gruppo',
    revH: 'Cosa dicono gli ospiti',
    revOn: `su Booking.com · ${sito.booking.recensioni} recensioni`,
    revThemes: ['Vista mozzafiato dal patio', 'Proprietari disponibili e gentili', 'Posizione comoda ma tranquilla', 'Appartamenti puliti e spaziosi'],
    revLink: 'Leggi le recensioni su Booking',
    directH: 'Prenota direttamente con noi',
    direct: ['Tariffa riservata a chi prenota dal sito', 'Check-in flessibile su richiesta', 'Parli direttamente con chi ti accoglie', 'Nessun costo di prenotazione'],
    ericeH: 'Erice, il borgo sopra le nuvole',
    ericeP: 'A 750 metri sul mare, Erice è un borgo medievale di pietra e vicoli. Da qui raggiungi a piedi il Castello di Venere, il Giardino del Balio e il Real Duomo. In auto o in funivia, Trapani, le Saline, San Vito Lo Capo e le isole Egadi sono vicine.',
    ericeBtn: 'Come arrivare',
  },
  en: {
    title: 'LEO Appartamenti · Apartments with a view in Erice',
    desc: 'Three apartments in Erice, just outside the old walls, with views over Trapani and the sea. Drive right up to the door. Personal welcome and flexible check-in.',
    h1: 'Erice, with a sea view',
    sub: 'Three apartments a short walk from Porta Trapani, with a panoramic patio, parking and a personal welcome.',
    discover: 'See the apartments',
    why: [
      ['Panoramic view', 'From the patio you can see Trapani and the sea. It’s what our guests remember most.'],
      ['A personal welcome', 'We meet you on arrival, with tips on where to eat and what to see. Flexible check-in on request.'],
      ['Drive to the door', 'We are outside the restricted traffic zone, with parking and an EV charging point. Porta Trapani and the cable car are a short walk away.'],
    ],
    aptsH: 'The apartments',
    aptsP: 'All with kitchen, air conditioning and heating, free Wi-Fi, washing machine and patio.',
    groupH: 'Travelling as a group?',
    groupP: 'Book the whole property: three neighbouring apartments for up to 15 people. Ideal for extended families and groups of friends.',
    groupBtn: 'Ask about groups',
    revH: 'What our guests say',
    revOn: `on Booking.com · ${sito.booking.recensioni} reviews`,
    revThemes: ['Breathtaking view from the patio', 'Helpful, friendly hosts', 'Convenient yet quiet location', 'Clean, spacious apartments'],
    revLink: 'Read the reviews on Booking',
    directH: 'Book directly with us',
    direct: ['Special rate when you book on our website', 'Flexible check-in on request', 'Talk directly to your hosts', 'No booking fees'],
    ericeH: 'Erice, the village above the clouds',
    ericeP: 'At 750 metres above the sea, Erice is a medieval village of stone and narrow lanes. From here you can walk to the Castle of Venus, the Balio Garden and the cathedral. By car or cable car, Trapani, the salt pans, San Vito Lo Capo and the Egadi Islands are close by.',
    ericeBtn: 'Getting here',
  },
}[lang];
const ld = {
  '@context': 'https://schema.org', '@type': 'LodgingBusiness', name: sito.nome, url: new URL(url('home', lang), Astro.site).href,
  address: { '@type': 'PostalAddress', streetAddress: 'Viale Conte Pepoli 17', postalCode: '91016', addressLocality: 'Erice', addressRegion: 'TP', addressCountry: 'IT' },
  geo: { '@type': 'GeoCoordinates', latitude: sito.lat, longitude: sito.lng },
  checkinTime: '15:00', checkoutTime: '11:00', petsAllowed: true,
  amenityFeature: ['Wi-Fi', 'Parking', 'Air conditioning', 'EV charging', 'Sea view'].map((name) => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
};
---
<Base lang={lang} page="home" title={T.title} description={T.desc}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />

  <section class="hero">
    <Image src={hero.src} alt={hero.alt} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="wrap">
      <h1>{T.h1}</h1>
      <p>{T.sub}</p>
      <div class="btns">
        <a class="btn light" href={url('avail', lang)}>{t.checkAvail}</a>
        <a class="btn ghost" style="color:#fff;border-color:#fff" href={url('apts', lang)}>{T.discover}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid three">
      {T.why.map(([h, p]) => <div class="feature"><h3>{h}</h3><p>{p}</p></div>)}
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2>{T.aptsH}</h2>
      <p class="lead">{T.aptsP}</p>
      <div class="grid three">
        {apts.map((a) => {
          const cover = photos(a.id, lang, a.nome)[0];
          return (
            <article class="card">
              <Image src={cover.src} alt={cover.alt} widths={[400, 800]} sizes="(max-width: 700px) 100vw, 360px" />
              <div class="body">
                <h3>{a.nome}</h3>
                <ul class="facts"><li>{a.mq} m²</li><li>{a.ospiti} {t.guests}</li>{a.camino && <li>{t.fireplace}</li>}</ul>
                <p>{a.breve[lang]}</p>
                <a class="btn ghost" href={url('apts', lang, a.id)}>{t.details} {a.nome}</a>
              </div>
            </article>
          );
        })}
      </div>
      <div class="cta-band" style="margin-top:32px">
        <div><h2>{T.groupH}</h2><p>{T.groupP}</p></div>
        <a class="btn light" href={url('avail', lang)}>{T.groupBtn}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid two">
      <div>
        <h2>{T.revH}</h2>
        <div class="rating">
          <span class="score">{lang === 'it' ? sito.booking.voto : sito.booking.voto.replace(',', '.')}</span>
          <span class="muted">/10 {T.revOn}</span>
        </div>
        <ul class="ticks" style="margin-top:20px">{T.revThemes.map((r) => <li>{r}</li>)}</ul>
        <p style="margin-top:16px"><a href={sito.booking.url} rel="noopener" target="_blank">{T.revLink} ↗</a></p>
      </div>
      <div>
        <h2>{T.directH}</h2>
        <ul class="ticks">{T.direct.map((r) => <li>{r}</li>)}</ul>
        <p style="margin-top:20px"><a class="btn" href={url('avail', lang)}>{t.checkAvail}</a></p>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap split">
      <div class="mosaic">
        {erice.map((p) => <Image src={p.src} alt={p.alt} widths={[400, 900]} sizes="(max-width: 820px) 100vw, 560px" />)}
      </div>
      <div>
        <h2>{T.ericeH}</h2>
        <p>{T.ericeP}</p>
        <a class="btn ghost" href={url('arrive', lang)}>{T.ericeBtn}</a>
      </div>
    </div>
  </section>
</Base>
