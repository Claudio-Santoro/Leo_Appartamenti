---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArtImage from '../components/ArtImage.astro';
import ApartmentCard from '../components/ApartmentCard.astro';
import Slides from '../components/Slides.astro';
import Fog from '../components/Fog.astro';
import apts from '../data/appartamenti.json';
import sito from '../data/sito.json';
import { url, ui } from '../i18n.js';
import { img } from '../images.js';
interface Props { lang: 'it' | 'en' }
const { lang } = Astro.props;
const t = ui[lang];
const score = lang === 'it' ? sito.booking.voto : sito.booking.voto.replace(',', '.');
const month = (d: string) => new Intl.DateTimeFormat(lang, { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(d));
const T = {
  it: {
    title: 'Leo Appartamenti · Appartamenti con vista a Erice',
    desc: 'Tre appartamenti per le vacanze a Erice, appena fuori dalle mura, con vista su Trapani e le Egadi. Parcheggio, Wi-Fi, check-in flessibile. Prenota direttamente.',
    h1: ['Erice,', 'sopra le nuvole.'],
    sub: 'Tre appartamenti appena fuori dalle mura, con il patio che guarda Trapani e il mare. Arrivi in auto fino alla porta, ti accogliamo noi.',
    discover: 'Gli appartamenti',
    trail: ['Erice', 'La vista', 'Le case', 'I servizi', 'Il borgo', 'Gli ospiti'], trailLabel: 'Il sentiero della pagina',
    heroAlt: 'Erice, il borgo di pietra sospeso sopra il mare e le nuvole',
    nightAlt: 'Un vicolo di Erice al crepuscolo, con un lampione acceso', vistaH: 'Da Erice: Trapani, il mare, le Egadi.',
    vistaP: 'Dal patio guardi Trapani e il mare: è la cosa che i nostri ospiti ricordano di più. Al tramonto le saline si accendono di rosa e le isole compaiono una dietro l’altra.',
    vistaAlt: 'Tramonto sul mare e sulle Egadi da una strada di Erice', aptsN: 'Gli appartamenti', aptsH: 'Venere, Elimo e Balio.',
    aptsP: 'Tre appartamenti vicini, tutti con cucina, aria condizionata, riscaldamento e Wi-Fi. Per i gruppi si prenotano insieme: fino a 15 persone.', servN: 'Altri servizi', servH: 'La tua giornata, la organizziamo noi.',
    servP: 'Ti aiutiamo a vivere Erice e i dintorni senza pensieri. Tutti i servizi sono su richiesta: chiedili quando prenoti o durante il soggiorno.',
    serv: [['Servizio taxi', 'Ti accompagniamo dove vuoi: in città, al porto, alla stazione o all’aeroporto.'], ['Tour delle Isole Egadi', 'Favignana, Levanzo e Marettimo in giornata, in barca o in aliscafo: organizziamo tutto noi.'], ['Degustazioni di vini', 'Visite e assaggi nelle cantine della zona, tra i vigneti della Sicilia occidentale.']],
    fogAlt: 'Il Castello di Venere a Erice, nella nebbia', fogNightAlt: 'Il Castello di Venere di notte, illuminato dai lampioni', borgoH: 'Tutto il borgo, a pochi passi.',
    borgoP: 'Siamo appena fuori dalle mura: in pochi minuti sei nel centro medievale, tra chiese, vicoli di pietra e pasticcerie.',
    walk: [['Porta Trapani', 'circa 110 m'], ['Real Duomo', 'circa 200 m'], ['Castello di Venere', 'circa 600 m'], ['Funivia per Trapani', 'a pochi minuti']],
    home: 'Da casa',
    borgoAlt: ['Porta Trapani', 'La Chiesa Madre di Erice con la sua torre campanaria', 'Il Castello di Venere sulla rupe', 'La funivia sopra la pianura di Trapani'],
    alts: {
      rami: 'Il campanile e la cupola di San Giuliano tra i rami', giuliano: 'La chiesa di San Giuliano a Erice', tetti: 'I tetti di Erice con la chiesa di San Giuliano', cupola: 'La cupola di San Giovanni Battista davanti al mare',
      duomo: 'I tetti di Erice e la torre campanaria del Real Duomo sotto le nuvole', controluce: 'Il campanile di San Giuliano in controluce tra i rami, all’imbrunire',
      giardino: 'Un giardino di Erice con i tetti del borgo', mura: 'Le mura del Castello di Venere sopra la valle', torretta: 'La Torretta Pepoli vista dall’alto', torrettaCastello: 'La Torretta Pepoli sotto il Castello di Venere',
      muraNotte: 'Le mura del Castello di Venere di notte, con un lampione acceso', balio: 'Il Castello di Venere e le torri del Balio all’imbrunire, con le luci accese',
    },
    zoom: 'Ingrandisci la foto', close: 'Chiudi', prev: 'Foto precedente', next: 'Foto successiva',
    revOn: `su Booking.com · ${sito.booking.recensioni} recensioni`,
    revH: 'Recensioni', revNote: 'Alcune recensioni scelte da Booking.com.', revLink: 'Leggi tutte le recensioni',
    arriveQ: 'Come si arriva fin quassù?', arriveP: 'In auto fino alla porta, siamo fuori dalla zona a traffico limitato e c’è parcheggio. Oppure in funivia da Trapani: dieci minuti sopra il mare, e scendi a pochi passi da noi. Su richiesta organizziamo anche un transfer a pagamento da Trapani o dall’aeroporto.', arriveCta: 'Come arrivare a Erice', guideCta: 'Cosa vedere a Erice', bookH: 'Scrivici, ti rispondiamo noi.',
    book: ['Tariffa riservata a chi prenota dal sito', 'Check-in flessibile su richiesta', 'Parli con chi ti accoglie', 'Nessun costo di prenotazione'],
  },
  en: {
    title: 'Leo Appartamenti · Apartments with a view in Erice',
    desc: 'Three holiday apartments in Erice, Sicily, just outside the old walls, overlooking Trapani and the Egadi Islands. Parking, Wi-Fi, flexible check-in. Book direct.',
    h1: ['Erice,', 'above the clouds.'],
    sub: 'Three apartments just outside the old walls, with a patio looking out over Trapani and the sea. Drive right up to the door — we’ll be there to welcome you.',
    discover: 'The apartments',
    trail: ['Erice', 'The view', 'The homes', 'Services', 'The village', 'Our guests'], trailLabel: 'Page trail',
    heroAlt: 'Erice, the stone village hanging above the sea and the clouds',
    nightAlt: 'An alley in Erice at dusk, with a street lamp lit', vistaH: 'From Erice: Trapani, the sea, the Egadi.',
    vistaP: 'From the patio you look out over Trapani and the sea: it’s what our guests remember most. At sunset the salt pans glow pink and the islands appear one behind the other.',
    vistaAlt: 'Sunset over the sea and the Egadi Islands from a road in Erice', aptsN: 'The apartments', aptsH: 'Venere, Elimo and Balio.',
    aptsP: 'Three neighbouring apartments, all with kitchen, air conditioning, heating and Wi-Fi. Groups can book them together: up to 15 people.', servN: 'More services', servH: 'Your day, organised by us.',
    servP: 'We help you enjoy Erice and its surroundings with no hassle. All services are on request: ask when you book or during your stay.',
    serv: [['Taxi service', 'We take you wherever you need: around town, to the port, the station or the airport.'], ['Egadi Islands tours', 'Favignana, Levanzo and Marettimo in a day, by boat or hydrofoil: we arrange everything.'], ['Wine tastings', 'Visits and tastings at local wineries, among the vineyards of western Sicily.']],
    fogAlt: 'The Castle of Venus in Erice, in the fog', fogNightAlt: 'The Castle of Venus at night, lit by street lamps', borgoH: 'The whole village, a few steps away.',
    borgoP: 'We are just outside the walls: in a few minutes you are in the medieval centre, among churches, stone lanes and pastry shops.',
    walk: [['Porta Trapani', 'about 110 m'], ['Cathedral', 'about 200 m'], ['Castle of Venus', 'about 600 m'], ['Cable car to Trapani', 'a few minutes']],
    home: 'From home',
    borgoAlt: ['Porta Trapani', 'The Chiesa Madre of Erice and its bell tower', 'The Castle of Venus on its cliff', 'The cable car above the Trapani plain'],
    alts: {
      rami: 'The bell tower and dome of San Giuliano through the branches', giuliano: 'The church of San Giuliano in Erice', tetti: 'The rooftops of Erice with the church of San Giuliano', cupola: 'The dome of San Giovanni Battista against the sea',
      duomo: 'The rooftops of Erice and the bell tower of the Real Duomo under the clouds', controluce: 'The bell tower of San Giuliano in silhouette through the branches at nightfall',
      giardino: 'A garden in Erice with the village rooftops', mura: 'The walls of the Castle of Venus above the valley', torretta: 'The Torretta Pepoli from above', torrettaCastello: 'The Torretta Pepoli below the Castle of Venus',
      muraNotte: 'The walls of the Castle of Venus at night, with a street lamp lit', balio: 'The Castle of Venus and the Balio towers at nightfall, with the lights on',
    },
    zoom: 'Enlarge photo', close: 'Close', prev: 'Previous photo', next: 'Next photo',
    revOn: `on Booking.com · ${sito.booking.recensioni} reviews`,
    revH: 'Reviews', revNote: 'A selection of reviews from Booking.com, translated by us.', revLink: 'Read all reviews',
    arriveQ: 'How do you get up here?', arriveP: 'By car right to the door: we are outside the restricted traffic zone and there is parking. Or by cable car from Trapani: ten minutes above the sea, and you step off a few minutes from us. On request we can also arrange a paid transfer from Trapani or the airport.', arriveCta: 'How to get to Erice', guideCta: 'Things to do in Erice', bookH: 'Write to us, we’ll reply.',
    book: ['Special rate when you book on our website', 'Flexible check-in on request', 'Talk directly to your hosts', 'No booking fees'],
  },
}[lang];
// Le tappe del borgo: foto e inquadratura dentro l'arco (object-position). Al clic si apre la foto intera.
const stops = [
  { file: 'borgo/m-porta-trapani', pos: '50% 50%', tall: true },
  { file: 'borgo/m-duomo', pos: '45% 40%', tall: true },
  { file: 'borgo/castello-venere', pos: '21% 50%', tall: false },
  { file: 'borgo/funivia', pos: '50% 50%', tall: true },
];
// Le foto che si alternano in apertura. Le luci (x, y sulla foto) sono misurate a mano: se cambia una foto, vanno rimisurate.
// La prima luce di ogni foto è quella che scalda la nebbia (fog3d.ts).
const muraNotte = { on: 'pn', src: img('borgo/m-mura-castello-notte'), alt: T.alts.muraNotte, lights: [[0.6685, 0.243, 46]] };
const heroSlides = [
  { on: 'dd dn pd', src: img('borgo/belvedere-nuvole'), mobile: img('borgo/m-vicolo-cofano'), alt: T.heroAlt, dim: true, lights: [[0.6896, 0.3799, 26]] },
  { on: 'pn', src: img('borgo/m-notte-vicolo'), alt: T.nightAlt, pos: '54% 50%', sizes: '190vw', lights: [[0.545, 0.422, 37]] },
  { on: 'dd', src: img('borgo/san-giuliano-rami'), alt: T.alts.rami, pos: '50% 60%' },
  { on: 'dd', src: img('borgo/san-giuliano'), alt: T.alts.giuliano, pos: '50% 12%' },
  { on: 'dd', src: img('borgo/san-giuliano-tetti'), alt: T.alts.tetti, pos: '50% 50%' },
  { on: 'dd', src: img('borgo/cupola-san-giovanni'), alt: T.alts.cupola, pos: '50% 40%' },
  { on: 'dd', src: img('erice/tetti'), alt: T.alts.duomo, pos: '50% 40%' },
  { on: 'dn', src: img('erice/tramonto'), alt: T.alts.controluce, pos: '50% 50%' },
  { on: 'pd', src: img('borgo/m-giardino'), alt: T.alts.giardino, pos: '50% 15%' },
  { on: 'pd', src: img('borgo/m-mura-castello'), alt: T.alts.mura, pos: '50% 30%' },
  { on: 'pd', src: img('borgo/m-torretta-pepoli'), alt: T.alts.torretta, pos: '50% 85%' },
  { ...muraNotte, pos: '50% 20%' },
  // dalla vecchia sezione della nebbia
  { on: 'dd pd', src: img('borgo/castello-nebbia'), mobile: img('borgo/m-castello'), alt: T.fogAlt, dim: true }, // di notte su computer, sotto il velo dell'apertura, era solo grigio scuro
  { on: 'dn', src: img('borgo/balio-notte'), alt: T.alts.balio, pos: '50% 45%', filter: 'brightness(.42) saturate(.95)', lights: [[0.81, 0.662, 13], [0.6586, 0.381, 9], [0.785, 0.38, 9], [0.493, 0.392, 8], [0.137, 0.548, 5]] },
  { on: 'pn', src: img('borgo/m-castello-notte'), alt: T.fogNightAlt, pos: '25% 0%', lights: [[0.4297, 0.3858, 20], [0.2076, 0.4225, 20], [0.5167, 0.4158, 17], [0.615, 0.4233, 17]] },
  { on: 'pd', src: img('borgo/m-torretta-castello'), alt: T.alts.torrettaCastello, pos: '60% 50%' },
];
const stopFull = await Promise.all(stops.map((st) => getImage({ src: img(st.file), width: 1600, format: 'webp' })));
const abs = (u: string) => new URL(u, Astro.site).href;
const logo = await getImage({ src: img('borgo/belvedere-nuvole'), width: 1200, format: 'jpg', quality: 80 });
const ld = {
  '@context': 'https://schema.org', '@type': 'LodgingBusiness', '@id': `${abs('/')}#struttura`, name: sito.nome, url: abs(url('home', lang)),
  description: T.desc, image: abs(logo.src), telephone: sito.telefono.replace(/\s/g, ''), email: sito.email,
  sameAs: [sito.booking.url], hasMap: `https://www.google.com/maps/search/?api=1&query=${sito.lat},${sito.lng}`,
  containsPlace: apts.map((a) => ({ '@type': 'Apartment', name: a.nome, url: abs(url('apts', lang, a.id)), floorSize: { '@type': 'QuantitativeValue', value: a.mq, unitCode: 'MTK' }, occupancy: { '@type': 'QuantitativeValue', maxValue: a.ospiti } })),
  address: { '@type': 'PostalAddress', streetAddress: 'Viale Conte Pepoli 17', postalCode: '91016', addressLocality: 'Erice', addressRegion: 'TP', addressCountry: 'IT' },
  geo: { '@type': 'GeoCoordinates', latitude: sito.lat, longitude: sito.lng },
  checkinTime: '15:00', checkoutTime: '11:00', petsAllowed: true,
  amenityFeature: ['Wi-Fi', 'Parking', 'Air conditioning', 'EV charging', 'Sea view'].map((name) => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
};
---
<Base lang={lang} page="home" title={T.title} description={T.desc} over>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />

  <nav class="sentiero" aria-label={T.trailLabel}>
    <ol>{['inizio', 'vista', 'appartamenti', 'servizi', 'borgo', 'ospiti'].map((id, i) => <li><a href={`#${id}`}><span>{T.trail[i]}</span></a></li>)}</ol>
  </nav>

  <section class="hero" id="inizio" data-enter>
    <Slides slides={heroSlides} eager />
    <Fog density={1.45} />
    <div class="wrap">
      <div class="enter">
        <h1>{T.h1[0]}<br />{T.h1[1]}</h1>
        <p>{T.sub}</p>
        <div class="btns">
          <a class="btn light" href={url('avail', lang)}>{t.checkAvail}</a>
          <a class="btn light" href={url('apts', lang)}>{T.discover}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="photo-sec left" id="vista">
    <div class="media"><ArtImage desktop={img('borgo/vista-tramonto')} mobile={img('erice/strada-tramonto')} mobileSizes="125vw" alt={T.vistaAlt} class="bg parallax" /></div>
    <div class="wrap">
      <div class="txt" data-reveal>
        <h2>{T.vistaH}</h2>
        <p>{T.vistaP}</p>
      </div>
    </div>
  </section>

  <section class="section" id="appartamenti">
    <div class="wrap head" data-reveal>
      <div><span class="num">{T.aptsN}</span><h2>{T.aptsH}</h2></div>
      <p>{T.aptsP}</p>
    </div>
    <div class="apts">
      {apts.map((a) => <ApartmentCard a={a} lang={lang} full />)}
    </div>
  </section>

  <section class="section alt" id="servizi">
    <div class="wrap">
      <div class="head" data-reveal>
        <div><span class="num">{T.servN}</span><h2>{T.servH}</h2></div>
        <p>{T.servP}</p>
      </div>
      <div class="grid three">
        {T.serv.map(([h, p], i) => <div data-reveal style={`--d:${i * .12}s`}><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section walk merli selciato" id="borgo">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2>{T.borgoH}</h2>
        <p>{T.borgoP}</p>
      </div>
      <p class="route-from"><span class="dot"></span>{T.home} · Viale Conte Pepoli</p>
      <ol class="route">
        <li class="start" data-reveal><span class="dot"></span><span class="name">{T.home}</span><span class="dist">Viale Conte Pepoli</span></li>
        {T.walk.map(([name, dist], i) => (
          <li data-reveal style={`--d:${(i + 1) * .12}s`}>
            <button type="button" class:list={['window', { tall: stops[i].tall }]} data-lantern data-full={stopFull[i].src} aria-label={`${T.zoom}: ${name}`}>
              <Image src={img(stops[i].file)} alt={T.borgoAlt[i]} widths={[400, 700, 1000]} sizes="(max-width: 800px) 70vw, 30vw" style={`object-position:${stops[i].pos}`} />
            </button>
            <span class="dot"></span>
            <span class="dist">{dist}</span>
            <span class="name">{name}</span>
          </li>
        ))}
      </ol>
      <div class="walk-more" data-reveal>
        <h3>{T.arriveQ}</h3>
        <p>{T.arriveP}</p>
        <div class="btns">
          <a class="btn" href={url('arrive', lang)}>{T.arriveCta} →</a>
          <a class="btn" href={url('erice', lang)}>{T.guideCta} →</a>
        </div>
      </div>
      <dialog class="lightbox" id="borgo-zoom">
        <img alt="" />
        <button type="button" class="close" aria-label={T.close}>×</button>
        <button type="button" class="prev" aria-label={T.prev}>‹</button>
        <button type="button" class="next" aria-label={T.next}>›</button>
      </dialog>
    </div>
  </section>

  <section class="trust merli" id="ospiti">
    <div class="alt" style="background:var(--calc-2)" data-reveal>
      <h2>{T.revH}</h2>
      <div class="score-wrap">
        <svg class="rosone" viewBox="-100 -100 200 200" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2.2">
          <circle r="96" /><circle r="86" /><circle r="22" /><circle r="12" />
          {Array.from({ length: 12 }, (_, i) => <g transform={`rotate(${i * 30})`}><circle cy="-54" r="28" /><path d="M0 -22V-86" /><circle cy="-91" r="3.5" /></g>)}
        </g></svg>
        <div class="score">{score}</div>
      </div>
      <p class="muted">{T.revOn}</p>
      <div class="quotes">{sito.booking.scelte.map((r) => <figure><blockquote>{lang === 'it' ? `«${r.testo.it}»` : `“${r.testo.en}”`}</blockquote><figcaption><b>{r.voto}/10</b> {r.nome}, {r.paese[lang]} · {month(r.data)}</figcaption></figure>)}</div>
      <p class="muted small">{T.revNote}</p>
      <a class="link" href={sito.booking.url} rel="noopener" target="_blank">{T.revLink} ↗</a>
    </div>
    <div class="dark" data-reveal style="--d:.15s">
      <h2>{T.bookH}</h2>
      <ul class="ticks" style="margin:28px 0 40px">{T.book.map((r) => <li>{r}</li>)}</ul>
      <div class="btns">
        <a class="btn light" href={url('avail', lang)}>{t.checkAvail}</a>
        <a class="btn wa" href={`https://wa.me/${sito.whatsapp}`}>WhatsApp</a>
      </div>
    </div>
  </section>

  <script>
    // Le tappe del borgo: al clic sull'arco la foto intera, senza ritaglio.
    const zoom = document.querySelector<HTMLDialogElement>('#borgo-zoom')!;
    const windows = [...document.querySelectorAll<HTMLButtonElement>('.route .window')];
    const zimg = zoom.querySelector('img')!;
    let zi = 0;
    const showStop = (n: number) => {
      zi = (n + windows.length) % windows.length;
      zimg.src = windows[zi].dataset.full!;
      zimg.alt = windows[zi].querySelector('img')!.alt;
    };
    windows.forEach((w, n) => w.addEventListener('click', () => { showStop(n); zoom.showModal(); }));
    zoom.querySelector('.close')!.addEventListener('click', () => zoom.close());
    zoom.querySelector('.prev')!.addEventListener('click', () => showStop(zi - 1));
    zoom.querySelector('.next')!.addEventListener('click', () => showStop(zi + 1));
    zoom.addEventListener('click', (e) => { if (e.target === zoom) zoom.close(); });
    zoom.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') showStop(zi - 1); if (e.key === 'ArrowRight') showStop(zi + 1); });

    // Il sentiero laterale segna la tappa in cui ti trovi.
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.sentiero a')];
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) links.forEach((a) => a.setAttribute('aria-current', String(a.hash === `#${e.target.id}`)));
    }, { rootMargin: '-45% 0px -45% 0px' });
    links.forEach((a) => { const sec = document.querySelector(a.hash); if (sec) io.observe(sec); });
  </script>
</Base>
