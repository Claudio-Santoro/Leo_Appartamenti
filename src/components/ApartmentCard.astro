---
// Scheda appartamento: intestazione + striscia di tutte le foto, scorrevole col dito, il trackpad o le frecce.
import { getImage } from 'astro:assets';
import { url, ui } from '../i18n.js';
import { photos } from '../images.js';
interface Props { a: any; lang: 'it' | 'en'; full?: boolean }
const { a, lang, full = false } = Astro.props;
const t = ui[lang];
const list = photos(a.id, lang, a.nome);
const href = url('apts', lang, a.id);
const imgs = await Promise.all(list.map((p) => getImage({ src: p.src, widths: [480, 800, 1200], format: 'webp' })));
const L = lang === 'it' ? { photos: `Foto di ${a.nome}`, prev: 'Foto precedente', next: 'Foto successiva' } : { photos: `Photos of ${a.nome}`, prev: 'Previous photo', next: 'Next photo' };
---
<article class="apt">
  <div class="wrap apt-head" data-reveal>
    <h3><a href={href}>{a.nome}</a></h3>
    <div>
      <p class="facts">{a.mq} m² · {a.ospiti} {t.guests}{a.camino && ` · ${t.fireplace.toLowerCase()}`}</p>
      {full && <p>{a.breve[lang]}</p>}
      <a class="link" href={href}>{t.details} {a.nome}</a>
    </div>
  </div>
  <div class="strip" data-reveal style="--d:.12s" tabindex="0" role="region" aria-label={L.photos}>
    {list.map((p, i) => (
      // La foto parte solo quando la striscia si avvicina (vedi script): all'apertura la banda resta all'immagine principale.
      <img data-src={imgs[i].src} data-srcset={imgs[i].srcSet.attribute} sizes="(max-width: 700px) 150vw, 50vw" alt={p.alt}
        width={p.src.width} height={p.src.height} decoding="async" />
    ))}
  </div>
  <div class="wrap strip-ctl">
    <span class="count" aria-hidden="true"><b>1</b> / {list.length}</span>
    <button type="button" class="prev" aria-label={L.prev}>←</button>
    <button type="button" class="next" aria-label={L.next}>→</button>
  </div>
</article>

<script>
  // Striscia di foto. Col dito: scorrimento nativo con scroll-snap. Col mouse: si afferra e si lancia;
  // il punto d'arrivo si proietta dalla velocità del gesto e una molla senza rimbalzo ci porta sulla foto più vicina.
  // Le frecce usano la stessa molla, che si può sempre interrompere riafferrando la striscia.
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const project = (v: number, d = 0.998) => (v / 1000) * d / (1 - d); // px/s -> px (Designing Fluid Interfaces)

  document.querySelectorAll<HTMLElement>('.apt').forEach((apt) => {
    const strip = apt.querySelector<HTMLElement>('.strip')!;
    const count = apt.querySelector('.count b')!;
    const imgs = [...strip.querySelectorAll('img')];
    // Il margine sinistro è quello della prima foto (lo scroll-padding calcolato arriva come testo "max(...)", non come numero).
    const snapOf = (i: number) => imgs[i].offsetLeft - imgs[0].offsetLeft;
    const nearest = (x: number) => imgs.reduce((best, _, i) => (Math.abs(snapOf(i) - x) < Math.abs(snapOf(best) - x) ? i : best), 0);
    const max = () => strip.scrollWidth - strip.clientWidth;

    let raf = 0;
    const stop = () => { cancelAnimationFrame(raf); raf = 0; };
    // Molla a smorzamento critico (damping 1.0, response 0.4 s), partendo dalla posizione e dalla velocità attuali.
    const springTo = (target: number, v = 0) => {
      stop();
      target = Math.max(0, Math.min(max(), target));
      if (still) { strip.scrollLeft = target; return; }
      strip.classList.add('free');
      const w = (2 * Math.PI) / 0.4;
      let x = strip.scrollLeft, last = performance.now();
      const step = (now: number) => {
        const dt = Math.min(0.032, (now - last) / 1000); last = now;
        v += (-w * w * (x - target) - 2 * w * v) * dt; x += v * dt;
        strip.scrollLeft = x;
        if (Math.abs(x - target) < 0.5 && Math.abs(v) < 8) { strip.scrollLeft = target; strip.classList.remove('free'); raf = 0; return; }
        raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };
    const go = (d: number) => springTo(snapOf(Math.max(0, Math.min(imgs.length - 1, nearest(strip.scrollLeft) + d))));
    apt.querySelector('.prev')!.addEventListener('click', () => go(-1));
    apt.querySelector('.next')!.addEventListener('click', () => go(1));
    strip.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); go(e.key === 'ArrowRight' ? 1 : -1); } });
    strip.addEventListener('scroll', () => { count.textContent = String(nearest(strip.scrollLeft) + 1); }, { passive: true });

    {
      // Solo mouse: col dito e col trackpad lo scorrimento resta quello nativo.
      let down = false, moved = false, x0 = 0, left0 = 0, hist: { x: number; t: number }[] = [];
      strip.addEventListener('pointerdown', (e) => {
        if (e.pointerType !== 'mouse' || e.button !== 0) return;
        stop(); down = true; moved = false; x0 = e.clientX; left0 = strip.scrollLeft; hist = [{ x: e.clientX, t: e.timeStamp }];
        strip.setPointerCapture(e.pointerId);
      });
      strip.addEventListener('pointermove', (e) => {
        if (!down) return;
        const dx = e.clientX - x0;
        if (!moved && Math.abs(dx) < 6) return; // piccola isteresi prima di decidere che è un trascinamento
        if (!moved) { moved = true; strip.classList.add('free', 'dragging'); }
        strip.scrollLeft = left0 - dx; // 1:1 con il mouse, rispettando il punto in cui l'hai afferrata
        hist.push({ x: e.clientX, t: e.timeStamp }); if (hist.length > 6) hist.shift();
      });
      const release = () => {
        if (!down) return; down = false; strip.classList.remove('dragging');
        if (!moved) { strip.classList.remove('free'); return; }
        const a = hist[0], b = hist[hist.length - 1], dt = Math.max(1, b.t - a.t);
        const v = -((b.x - a.x) / dt) * 1000; // velocità di scorrimento in px/s
        springTo(snapOf(nearest(strip.scrollLeft + project(v))), v);
      };
      strip.addEventListener('pointerup', release);
      strip.addEventListener('pointercancel', release);
    }

    // Quando la striscia si avvicina allo schermo carichiamo tutte le sue foto: scorrendo non resta mai un riquadro vuoto.
    new IntersectionObserver(([e], io) => {
      if (!e.isIntersecting) return;
      imgs.forEach((img) => { img.srcset = img.dataset.srcset!; img.src = img.dataset.src!; });
      io.disconnect();
    }, { rootMargin: '600px 0px' }).observe(strip);
  });
</script>
