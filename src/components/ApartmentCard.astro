---
import { Image } from 'astro:assets';
import { url, ui } from '../i18n.js';
import { photos } from '../images.js';
interface Props { a: any; lang: 'it' | 'en'; n: string; full?: boolean }
const { a, lang, n, full = false } = Astro.props;
const t = ui[lang];
const cover = photos(a.id, lang, a.nome)[0];
---
<a class="apt" href={url('apts', lang, a.id)} data-reveal>
  <div class="frame"><Image class="arch" src={cover.src} alt={cover.alt} widths={[420, 640, 900]} sizes="(max-width: 900px) 92vw, 30vw" /></div>
  <div class="meta"><span class="num">{n}</span><h3>{a.nome}</h3></div>
  <p class="facts">{a.mq} m² · {a.ospiti} {t.guests}{a.camino && ` · ${t.fireplace.toLowerCase()}`}</p>
  {full && <p>{a.breve[lang]}</p>}
  <span class="link">{t.details} {a.nome}</span>
</a>
