---
// Nebbia vera: rumore frattale in WebGL che scorre lento, si apre attorno al cursore o al dito
// e di notte prende la luce calda dei lampioni. Senza WebGL resta una nebbia dipinta in CSS;
// con "riduci movimento" resta un solo fotogramma fermo.
interface Props { density?: number }
const { density = 1 } = Astro.props;
---
<canvas class="fog-canvas" data-density={density} aria-hidden="true"></canvas>
<div class="fog-css" aria-hidden="true"></div>

<script>
  const FRAG = `
precision mediump float;
uniform vec2 r; uniform float t; uniform vec2 m; uniform float night; uniform float dens;
float h(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float n(vec2 p){ vec2 i = floor(p), f = fract(p); f = f*f*(3.0-2.0*f);
  return mix(mix(h(i), h(i+vec2(1,0)), f.x), mix(h(i+vec2(0,1)), h(i+vec2(1,1)), f.x), f.y); }
float fbm(vec2 p){ float v = 0.0, a = 0.5; for (int i = 0; i < 4; i++){ v += a*n(p); p = p*2.03 + vec2(1.7, 9.2); a *= 0.5; } return v; }
void main(){
  vec2 uv = gl_FragCoord.xy / r;
  vec2 p = uv * vec2(r.x/r.y, 1.0) * 2.4;
  vec2 q = vec2(fbm(p + vec2(t*0.045, t*0.014)), fbm(p + vec2(5.2, 1.3) - t*0.03));
  float f = fbm(p + 1.8*q + vec2(-t*0.08, t*0.022));
  float d = min(1.0, smoothstep(0.38, 0.92, f) * dens * mix(1.0, 1.5, night)); // di notte più fitta
  d *= 0.45 + 0.75*(1.0 - uv.y);                      // più densa in basso: la nebbia sale dalla valle
  vec2 dm = (uv - m) * vec2(r.x/r.y, 1.0);
  float hole = smoothstep(0.04, 0.32, length(dm));     // il varco attorno al cursore
  d *= mix(0.08, 1.0, hole);
  vec3 c = mix(vec3(0.93, 0.93, 0.91), vec3(0.50, 0.54, 0.58), night);
  c = mix(c, vec3(1.0, 0.76, 0.40), night * (1.0 - smoothstep(0.0, 0.5, length(dm))) * 0.75);
  gl_FragColor = vec4(c*d, d);
}`;
  const VERT = 'attribute vec2 a; void main(){ gl_Position = vec4(a, 0.0, 1.0); }';
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const coarse = matchMedia('(pointer: coarse)').matches;

  // La nebbia è in three.js (fog3d.ts, caricato solo dopo il caricamento della pagina); questo shader 2D è il ripiego.
  const isSoftware = () => {
    const g = document.createElement('canvas').getContext('webgl');
    const d = g?.getExtension('WEBGL_debug_renderer_info');
    return !g || /swiftshader|llvmpipe|software/i.test(d ? g.getParameter(d.UNMASKED_RENDERER_WEBGL) : '');
  };
  // three.js ovunque ci sia una scheda grafica; resta lo shader 2D senza GPU, con "riduci movimento" o con "risparmio dati".
  const saveData = (navigator as any).connection?.saveData === true;
  const use3d = !still && !saveData && (!isSoftware() || location.search.includes('nebbia'));

  document.querySelectorAll<HTMLCanvasElement>('canvas.fog-canvas').forEach((cv) => {
    const host = cv.parentElement!;
    if (use3d) {
      const go = () => import('./fog3d').then((m) => { m.startFog3d(host, Number(cv.dataset.density || 1)); cv.remove(); })
        .catch(() => host.classList.add('no-gl'));
      const idle = (window as any).requestIdleCallback ?? ((f: () => void) => setTimeout(f, 300));
      const later = () => setTimeout(() => idle(go, { timeout: 1500 }), 400);
      if (document.readyState === 'complete') later(); else addEventListener('load', later, { once: true });
      return;
    }
    const gl = cv.getContext('webgl', { premultipliedAlpha: true, antialias: false, alpha: true });
    if (!gl) { host.classList.add('no-gl'); return; }
    const sh = (type: number, src: string) => { const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s); return s; };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT)); gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG)); gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) { host.classList.add('no-gl'); return; }
    gl.useProgram(prog);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'a'); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const U = (k: string) => gl.getUniformLocation(prog, k);
    const uR = U('r'), uT = U('t'), uM = U('m'), uN = U('night'), uD = U('dens');
    gl.uniform1f(uD, Number(cv.dataset.density || 1));

    // ponytail: la nebbia è morbida, quindi la disegniamo a bassa risoluzione e la lascia sfumare il browser.
    let scale = coarse ? 0.28 : 0.42;
    const size = () => { cv.width = Math.max(2, Math.round(host.clientWidth * scale)); cv.height = Math.max(2, Math.round(host.clientHeight * scale)); gl.viewport(0, 0, cv.width, cv.height); gl.uniform2f(uR, cv.width, cv.height); };
    size(); new ResizeObserver(size).observe(host);

    let night = document.documentElement.dataset.time === 'night' ? 1 : 0, nightGoal = night;
    new MutationObserver(() => { nightGoal = document.documentElement.dataset.time === 'night' ? 1 : 0; if (still) draw(0); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['data-time'] });

    // Il varco segue il puntatore con un po' di ritardo, come la nebbia vera che si richiude.
    const goal = { x: -2, y: -2 }, pos = { x: -2, y: -2 };
    if (!still) {
      host.addEventListener('pointermove', (e) => { const b = host.getBoundingClientRect(); goal.x = (e.clientX - b.left) / b.width; goal.y = 1 - (e.clientY - b.top) / b.height; if (pos.x < -1) { pos.x = goal.x; pos.y = goal.y; } });
      host.addEventListener('pointerleave', () => { goal.x = -2; goal.y = -2; });
    }

    const t0 = performance.now();
    const draw = (now: number) => {
      pos.x += (goal.x - pos.x) * 0.06; pos.y += (goal.y - pos.y) * 0.06;
      night += (nightGoal - night) * 0.05;
      gl.uniform1f(uT, still ? 40 : (now - t0) / 1000 + 40);
      gl.uniform2f(uM, pos.x, pos.y);
      gl.uniform1f(uN, still ? nightGoal : night);
      gl.clearColor(0, 0, 0, 0); gl.clear(gl.COLOR_BUFFER_BIT);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };
    // Senza scheda grafica (WebGL in software: SwiftShader, llvmpipe) ogni fotogramma pesa sul processore:
    // lì la nebbia resta un'immagine ferma. ?nebbia la forza comunque in movimento (per le registrazioni).
    const dbg = gl.getExtension('WEBGL_debug_renderer_info');
    const software = /swiftshader|llvmpipe|software/i.test(dbg ? gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL) : '') && !location.search.includes('nebbia');
    if (still || software) { draw(0); cv.classList.add('ready'); return; }

    // Gira solo quando si vede e quando la scheda è in primo piano; parte dopo il caricamento,
    // per non rubare tempo al primo disegno della pagina. Se i fotogrammi sono lenti abbassa la qualità da sola.
    let raf = 0, visible = false, started = false, frames = 0, slow = 0, last = 0, skip = coarse;
    const loop = (now: number) => {
      raf = requestAnimationFrame(loop);
      const dt = now - last; last = now;
      if (skip && frames++ % 2) return; // su telefono basta mezzo frame rate: la nebbia è lenta
      draw(now);
      if (dt > 34 && frames > 3) slow++;
      if (slow > 20 && scale > 0.16) { scale *= 0.7; size(); slow = 0; skip = true; }
    };
    const sync = () => { cancelAnimationFrame(raf); if (started && visible && !document.hidden) { last = performance.now(); raf = requestAnimationFrame(loop); } };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }).observe(host);
    document.addEventListener('visibilitychange', sync);
    const start = () => { started = true; draw(performance.now()); cv.classList.add('ready'); sync(); };
    const idle = (window as any).requestIdleCallback ?? ((f: () => void) => setTimeout(f, 300));
    const later = () => setTimeout(() => idle(start, { timeout: 1500 }), 400);
    if (document.readyState === 'complete') later(); else addEventListener('load', later, { once: true });
  });
</script>
