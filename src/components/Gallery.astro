---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { photos: { src: ImageMetadata; alt: string }[]; lang: 'it' | 'en' }
const { photos, lang } = Astro.props;
const full = await Promise.all(photos.map((p) => getImage({ src: p.src, width: 1800, format: 'webp' })));
const L = lang === 'it' ? { open: 'Apri foto', close: 'Chiudi', prev: 'Foto precedente', next: 'Foto successiva' } : { open: 'Open photo', close: 'Close', prev: 'Previous photo', next: 'Next photo' };
---
<div class="gallery">
  {photos.map((p, i) => (
    <button type="button" data-full={full[i].src} data-alt={p.alt} aria-label={`${L.open}: ${p.alt}`}>
      <Image class="soft" src={p.src} alt={p.alt} widths={i === 0 ? [600, 1200] : [400, 700]} sizes={i === 0 ? '(max-width: 700px) 84vw, 560px' : '(max-width: 700px) 84vw, 280px'} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
    </button>
  ))}
</div>
<dialog class="lightbox">
  <img alt="" />
  <button type="button" class="close" aria-label={L.close}>×</button>
  <button type="button" class="prev" aria-label={L.prev}>‹</button>
  <button type="button" class="next" aria-label={L.next}>›</button>
</dialog>

<script>
  const items = [...document.querySelectorAll<HTMLButtonElement>('.gallery button')];
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox');
  if (dlg && items.length) {
    const img = dlg.querySelector('img')!;
    let i = 0;
    const show = (n: number) => {
      i = (n + items.length) % items.length;
      img.src = items[i].dataset.full!;
      img.alt = items[i].dataset.alt!;
    };
    items.forEach((b, n) => b.addEventListener('click', () => { show(n); dlg.showModal(); }));
    dlg.querySelector('.close')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.prev')!.addEventListener('click', () => show(i - 1));
    dlg.querySelector('.next')!.addEventListener('click', () => show(i + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
  }
</script>
