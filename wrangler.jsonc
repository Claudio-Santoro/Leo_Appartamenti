{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leo-appartamenti",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "run_worker_first": ["/api/*"], "not_found_handling": "404-page" },
  // al massimo 5 richieste del modulo al minuto per IP
  "ratelimits": [{ "name": "LIMITE", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true }
}
